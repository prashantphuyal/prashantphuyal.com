# ─── Lead notifications (primary channel: Amazon SES) ────────────────────────
# All of AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, MAIL_FROM and
# LEAD_NOTIFY_EMAIL must be set for email to be attempted.
# In Cloudflare, add these as Worker *secrets*, not plain vars.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sender. Must be an identity verified in SES (an address, or its whole domain).
MAIL_FROM=prashant@blanxer.com
MAIL_FROM_NAME=Prashant

# Where consultation requests are delivered.
LEAD_NOTIFY_EMAIL=prashant.phuyal.pp@gmail.com

# ─── Optional fallback ───────────────────────────────────────────────────────
# If SES fails, the lead is POSTed here as JSON instead (Zapier, Make, n8n,
# Apps Script, your own endpoint — anything accepting a JSON POST).
LEAD_WEBHOOK_URL=

# Shown to the visitor if every channel fails, so the lead isn't lost.
NEXT_PUBLIC_CONTACT_EMAIL=prashant@blanxer.com
